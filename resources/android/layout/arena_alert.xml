<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/arena_panel_bg"
    android:padding="12dp"
    android:layout_width="270dp"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#F5B83D"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Contacter l'organisateur" />
        <TextView
            android:id="@+id/arenaAlertClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textColor="#8A98BF"
            android:textSize="16sp"
            android:text="✕" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#B9C2DE"
        android:textSize="12sp"
        android:text="Décris le problème (eFootball, adversaire...). L'organisateur est prévenu immédiatement." />

    <EditText
        android:id="@+id/arenaAlertInput"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/arena_input_bg"
        android:textColor="#E8EEFF"
        android:textColorHint="#8A98BF"
        android:textSize="13sp"
        android:gravity="top"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:hint="Ton message..."
        android:inputType="textMultiLine" />

    <TextView
        android:id="@+id/arenaAlertSend"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/arena_send_btn_bg"
        android:gravity="center"
        android:textColor="#1A1200"
        android:textStyle="bold"
        android:textSize="13.5sp"
        android:text="Envoyer à l'organisateur" />

</LinearLayout>
